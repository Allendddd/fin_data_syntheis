{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mint-synth.local/schema/config-v2.json",
  "title": "mint-synth v2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run", "input", "output", "slurm", "llm"],
  "properties": {
    "version": {"const": 2},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "work_dir"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "work_dir": {"type": "string", "minLength": 1},
        "random_seed": {"type": "integer", "default": 42},
        "fingerprint_mode": {"enum": ["metadata", "sha256"], "default": "metadata"},
        "cutoff": {"type": "string", "format": "date"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["paths", "text_field"],
      "properties": {
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recursive": {"type": "boolean", "default": true},
        "include": {"type": "array", "items": {"type": "string"}, "default": ["**/*.jsonl", "**/*.parquet"]},
        "exclude": {"type": "array", "items": {"type": "string"}, "default": []},
        "follow_symlinks": {"type": "boolean", "default": false},
        "text_field": {"type": "string", "minLength": 1},
        "max_text_chars": {"type": "integer", "minimum": 1, "default": 20000000},
        "max_jsonl_line_bytes": {"type": "integer", "minimum": 1024, "default": 67108864},
        "id_field": {"type": ["string", "null"], "default": null},
        "metadata_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "invalid_record_policy": {"enum": ["quarantine", "fail"], "default": "quarantine"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "compression": {"enum": ["zstd", "snappy", "gzip", "none"], "default": "zstd"},
        "parquet_row_group_rows": {"type": "integer", "minimum": 2048, "default": 50000},
        "export_formats": {"type": "array", "items": {"enum": ["parquet", "jsonl"]}, "minItems": 1, "uniqueItems": true, "default": ["parquet"]},
        "artifact_checksums": {"type": "boolean", "default": true}
      }
    },
    "slurm": {
      "type": "object", "additionalProperties": false,
      "required": ["apptainer_image"],
      "properties": {
        "account": {"type": ["string", "null"], "default": null},
        "partition": {"type": "string", "minLength": 1, "default": "compute"},
        "qos": {"type": ["string", "null"], "default": null},
        "apptainer_image": {"type": "string", "minLength": 1},
        "image_fingerprint_mode": {"enum": ["metadata", "sha256"], "default": "sha256"},
        "bind_paths": {"type": "array", "items": {"type": "string"}, "default": []},
        "max_parallel_tasks": {"type": "integer", "minimum": 1, "default": 64},
        "max_array_tasks": {"type": "integer", "minimum": 1, "default": 1000},
        "extra_sbatch_args": {"type": "array", "items": {"type": "string"}, "default": []},
        "stage_resources": {
          "type": "object", "default": {},
          "propertyNames": {"enum": ["normalize", "id_validation", "dedup", "facts", "atomic", "entity_resolution", "repartition", "graph_planning", "query_realization", "validation", "export"]},
          "additionalProperties": {"$ref": "#/$defs/resources"}
        }
      }
    },
    "llm": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoints", "roles"],
      "properties": {
        "endpoints": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["base_url", "api_key_env"],
            "properties": {
              "base_url": {"type": "string", "minLength": 1},
              "api_key_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "require_api_key": {"type": "boolean", "default": true},
              "strict_json": {"type": "boolean", "default": true},
              "send_seed": {"type": "boolean", "default": false}
            }
          }
        },
        "roles": {
          "type": "object", "additionalProperties": false,
          "required": ["extractor", "constructor", "auditor", "entity_resolver"],
          "properties": {
            "extractor": {"$ref": "#/$defs/role"},
            "constructor": {"$ref": "#/$defs/role"},
            "auditor": {"$ref": "#/$defs/role"},
            "entity_resolver": {"$ref": "#/$defs/role"}
          }
        },
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 120},
        "retries": {"type": "integer", "minimum": 0, "default": 4},
        "backoff_seconds": {"type": "number", "minimum": 0, "default": 1},
        "concurrency_per_worker": {"type": "integer", "minimum": 1, "default": 8},
        "cache": {
          "type": "object", "additionalProperties": false, "default": {},
          "properties": {
            "backend": {"enum": ["sqlite", "none"], "default": "sqlite"},
            "policy": {"enum": ["immutable", "refresh"], "default": "immutable"},
            "busy_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 60}
          }
        }
      }
    },
    "reader": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "batch_rows": {"type": "integer", "minimum": 1, "default": 8192},
        "jsonl_byte_shard_size": {"type": "integer", "minimum": 1048576, "default": 1073741824},
        "normalize_target_bytes": {"type": "integer", "minimum": 1048576, "default": 8589934592},
        "dedup_buckets": {"type": "integer", "minimum": 1, "maximum": 65536, "default": 4096},
        "shuffle_partitions": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256},
        "external_id_partitions": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256},
        "duckdb_memory_limit": {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.[0-9]+)?(?:KB|MB|GB|TB|KiB|MiB|GiB|TiB)$", "default": "8GB"},
        "duckdb_threads": {"type": "integer", "minimum": 1, "default": 4}
      }
    },
    "chunking": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "max_chars": {"type": "integer", "minimum": 200, "default": 6000},
        "overlap_chars": {"type": "integer", "minimum": 0, "default": 400},
        "min_chars": {"type": "integer", "minimum": 1, "default": 600}
      }
    },
    "extraction": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "max_facts_per_chunk": {"type": "integer", "minimum": 1, "default": 30},
        "max_entity_chars": {"type": "integer", "minimum": 16, "default": 256},
        "max_metric_chars": {"type": "integer", "minimum": 16, "default": 256},
        "max_period_chars": {"type": "integer", "minimum": 8, "default": 64}
      }
    },
    "atomic": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "tasks_per_chunk": {"type": "integer", "minimum": 0, "default": 2},
        "language": {"enum": ["auto", "zh", "en"], "default": "auto"}
      }
    },
    "query_realization": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "seed_file": {"type": ["string", "null"], "default": null},
        "language": {"enum": ["auto", "zh", "en"], "default": "auto"},
        "max_question_chars": {"type": "integer", "minimum": 50, "default": 1000}
      }
    },
    "entity_resolution": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "alias_file": {"type": ["string", "null"], "default": null},
        "identifier_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "llm_fallback": {"type": "boolean", "default": true},
        "llm_max_evidence_facts": {"type": "integer", "minimum": 1, "default": 50},
        "llm_max_surfaces": {"type": "integer", "minimum": 2, "default": 100},
        "buckets": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256},
        "max_facts_per_block": {"type": "integer", "minimum": 100, "default": 250000}
      }
    },
    "dag": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "formula_registry": {"type": "string", "default": "builtin"},
        "max_depth": {"type": "integer", "minimum": 1, "default": 4},
        "min_depth": {"type": "integer", "minimum": 1, "default": 2},
        "beam_width": {"type": "integer", "minimum": 1, "default": 32},
        "max_candidate_groups_per_formula": {"type": "integer", "minimum": 16, "default": 4096},
        "max_graphs_per_entity": {"type": "integer", "minimum": 1, "default": 8},
        "max_facts_per_entity": {"type": "integer", "minimum": 100, "default": 100000},
        "min_sources": {"type": "integer", "minimum": 1, "default": 2},
        "entity_buckets": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 2048},
        "allowed_operations": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["identity", "add", "sum", "subtract", "difference", "multiply", "divide", "ratio", "percent_change", "average", "min", "max", "abs", "negate", "equals", "greater_than", "less_than", "greater_or_equal", "less_or_equal", "and", "or"]},
          "default": ["subtract", "percent_change", "ratio", "average", "abs", "equals", "and"]
        },
        "llm_supplement": {"type": "boolean", "default": true},
        "min_rule_graphs_before_supplement": {"type": "integer", "minimum": 0, "default": 1},
        "supplement_max_facts": {"type": "integer", "minimum": 2, "default": 80},
        "supplement_max_relations": {"type": "integer", "minimum": 1, "default": 20}
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "max_invalid_record_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.001},
        "max_external_id_conflict_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.001},
        "max_llm_terminal_error_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.02},
        "max_validation_failure_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.01},
        "require_independent_auditor": {"type": "boolean", "default": true},
        "overlap_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.82},
        "answer_tolerance": {"type": "string", "pattern": "^[0-9.eE+-]+$", "default": "1e-6"},
        "evaluation_file": {"type": ["string", "null"], "default": null},
        "max_evaluation_questions": {"type": "integer", "minimum": 1, "default": 100000},
        "min_validated_tasks": {"type": "integer", "minimum": 0, "default": 1}
      }
    },
    "stages": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "normalize": {"type": "boolean", "default": true},
        "facts": {"type": "boolean", "default": true},
        "atomic": {"type": "boolean", "default": true},
        "entity_resolution": {"type": "boolean", "default": true},
        "graph_planning": {"type": "boolean", "default": true},
        "query_realization": {"type": "boolean", "default": true},
        "validation": {"type": "boolean", "default": true},
        "export": {"type": "boolean", "default": true}
      }
    },
    "logging": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "level": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR"], "default": "INFO"},
        "json": {"type": "boolean", "default": true}
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "model"],
      "properties": {
              "endpoint": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "revision": {"type": ["string", "null"], "default": null},
              "temperature": {"type": "number", "minimum": 0, "maximum": 2, "default": 0},
              "max_tokens": {"type": ["integer", "null"], "minimum": 1, "default": null}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cpus": {"type": "integer", "minimum": 1, "default": 4},
        "memory": {"type": "string", "pattern": "^[0-9]+[KMGTP]?$", "default": "16G"},
        "time": {"type": "string", "pattern": "^[0-9]+(:[0-9]{2}){1,2}$", "default": "04:00:00"},
        "gpus": {"type": "integer", "minimum": 0, "default": 0},
        "max_parallel_tasks": {"type": ["integer", "null"], "minimum": 1, "default": null}
      }
    }
  }
}
